#!/bin/bash
# Finish install: ownership and Gatekeeper quarantine cleanup for local/dev-signed builds.
set -euo pipefail

APP="/Applications/Parrot.app"
if [ -d "$APP" ]; then
  /usr/sbin/chown -R root:wheel "$APP" 2>/dev/null || true
  /bin/chmod -R a+rX "$APP" 2>/dev/null || true
  /usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
fi

exit 0
